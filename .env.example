# Market data
MARKET_DATA_PROVIDER=alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# SEC fair-access User-Agent contact. Set this before using live EDGAR data.
SEC_CONTACT_EMAIL=
HISTORY_YEARS=3
LIVE_REFRESH_SECONDS=180
BROAD_SCAN_SECONDS=900
MAX_LIVE_EQUITY_SYMBOLS=30

# Assets
BTC_SYMBOL=BTC/USD

# LLM roles: Gemini researches; GPT reviews the portfolio. Never places orders.
LLM_PROVIDER=
LLM_MODEL=
LLM_JUDGE_MODEL=gpt-5.6-sol
GEMINI_RESEARCH_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_FINAL_MAX_NAMES=7
LLM_RESEARCH_MAX_NAMES=16
# UTC 날짜별 자동 LLM 호출의 사전 검사 기준값(soft limit). 실제 결제액의 절대 상한은 아닙니다.
LLM_DAILY_BUDGET_USD=15.0
GEMINI_WEB_SEARCH=true
GEMINI_DEADLINE_SECONDS=300
SOL_JUDGE_DEADLINE_SECONDS=900

# Optional KakaoTalk personal notifications (Send to Me — not Alimtalk)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:8743/auth/kakao/callback

# Daily scan: NYSE weekdays, 60 minutes before 09:30 America/New_York. Weekends/holidays skipped.
# The UI process posts /run-once to itself (no second DuckDB writer).
DAILY_SCAN_ENABLED=true
DAILY_SCAN_MINUTES_BEFORE_OPEN=60
# Model-only retrain: every NYSE session, 60 minutes after close. No SEC/LLM calls.
DAILY_TRAIN_ENABLED=true
DAILY_TRAIN_MINUTES_AFTER_CLOSE=60

# Quant allocation (score-to-weight). Opportunity score already includes conf/vol/agreement.
# max_total_stock_weight is a HARD CAP, not a target to fill.
MIN_OPPORTUNITY_SCORE=0.01
MIN_POSITION_WEIGHT=0.01
MAX_EQUITY_POSITIONS=20
MAX_SINGLE_STOCK_WEIGHT=0.25
MAX_TOTAL_STOCK_WEIGHT=1.0
MIN_CASH_WEIGHT=0.0
MAX_BTC_WEIGHT=0.30
RISK_APPETITE=aggressive
# "Strong" V1 stand-in: +4% mean 5/10/20 expected return at conf=1, vol=0.02, horizons agree.
# Converted to opportunity_score inside the allocator. Not yet OOS-calibrated.
STRONG_HORIZON_MEAN_RETURN=0.04
# Optional: set this to skip the conversion and pin the opportunity_score directly.
# STRONG_OPPORTUNITY_SCORE=
# Optional: how many fully-strong names fill the equity cap. Default = 1.0/0.25 = 4
# FULL_DEPLOYMENT_EQUIVALENT_NAMES=

# User-facing actionability (fractions of total_base_units; does not change model scores)
# 1% of the book is the smallest new target shown as a trade; 0.5% is the smallest change.
MIN_ACTIONABLE_WEIGHT=0.01
MIN_DELTA_WEIGHT=0.005
DISPLAY_UNIT_STEP_WEIGHT=0.001
MIN_ACTIONABLE_UNITS_FLOOR=0

# Storage / determinism
DUCKDB_PATH=data/investment_assistant.duckdb
RANDOM_SEED=42
